{
  "name": "ai-flow-metrics",
  "displayName": "AI Flow Metrics",
  "description": "Run the AI Flow Metrics pipeline from VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-flow-metrics",
          "title": "AI Flow Metrics",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-flow-metrics": [
        {
          "id": "aiFlowMetrics.pipeline",
          "name": "Pipeline"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-flow-metrics.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ai-flow-metrics.fetchData",
        "title": "Fetch ADO Data",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ai-flow-metrics.fetchData",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.fetch",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
