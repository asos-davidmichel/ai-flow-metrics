{
  "name": "ai-flow-metrics",
  "displayName": "AI Flow Metrics",
  "description": "Run the AI Flow Metrics pipeline from VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-flow-metrics",
          "title": "AI Flow Metrics",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-flow-metrics": [
        {
          "id": "aiFlowMetrics.boards",
          "name": "Boards"
        },
        {
          "id": "aiFlowMetrics.pipeline",
          "name": "Pipeline"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-flow-metrics.addBoard",
        "title": "Add Board",
        "icon": "$(add)"
      },
      {
        "command": "ai-flow-metrics.selectBoard",
        "title": "Select Board"
      },
      {
        "command": "ai-flow-metrics.clearOutput",
        "title": "Clear Output",
        "icon": "$(trash)"
      },
      {
        "command": "ai-flow-metrics.removeBoard",
        "title": "Remove Board",
        "icon": "$(remove-close)"
      },
      {
        "command": "ai-flow-metrics.fetchContext",
        "title": "Fetch Board Context",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.fetchWorkItems",
        "title": "Fetch Work Items",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.checkData",
        "title": "Run Data Quality Checks",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.configureBoard",
        "title": "Configure Board (AI)",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.calculateTimeInColumns",
        "title": "Calculate Time in Columns",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.calculateCycleTime",
        "title": "Calculate Cycle Time",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.calculateLeadTime",
        "title": "Calculate Lead Time",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.generateDashboard",
        "title": "Generate Dashboard",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.interpretMetrics",
        "title": "Interpret Metrics (AI)",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.regenerateDashboard",
        "title": "Re-generate Dashboard",
        "icon": "$(play)"
      },
      {
        "command": "ai-flow-metrics.runFetchAndCheckGroup",
        "title": "Run Fetch & Check",
        "icon": "$(run-all)"
      },
      {
        "command": "ai-flow-metrics.runCalculationsGroup",
        "title": "Run All Calculations",
        "icon": "$(run-all)"
      },
      {
        "command": "ai-flow-metrics.deleteFile",
        "title": "Delete File",
        "icon": "$(trash)"
      },
      {
        "command": "ai-flow-metrics.previewFile",
        "title": "Preview File"
      },
      {
        "command": "ai-flow-metrics.autoplay",
        "title": "Autoplay: run all steps uninterrupted",
        "icon": "$(run-all)"
      },
      {
        "command": "ai-flow-metrics.autoplayWithReview",
        "title": "Autoplay: pause after board config for review",
        "icon": "$(debug-step-over)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ai-flow-metrics.addBoard",
          "when": "view == aiFlowMetrics.boards",
          "group": "navigation"
        },
        {
          "command": "ai-flow-metrics.autoplay",
          "when": "view == aiFlowMetrics.pipeline",
          "group": "navigation"
        },
        {
          "command": "ai-flow-metrics.autoplayWithReview",
          "when": "view == aiFlowMetrics.pipeline",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ai-flow-metrics.clearOutput",
          "when": "view == aiFlowMetrics.boards && viewItem =~ /^board/",
          "group": "1_manage"
        },
        {
          "command": "ai-flow-metrics.removeBoard",
          "when": "view == aiFlowMetrics.boards && viewItem =~ /^board/",
          "group": "1_manage"
        },
        {
          "command": "ai-flow-metrics.fetchContext",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.fetchContext",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.fetchWorkItems",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.fetchItems",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.checkData",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.checkData",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.configureBoard",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.configureBoard",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.calculateTimeInColumns",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.calcColumns",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.calculateCycleTime",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.calcCycleTime",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.calculateLeadTime",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.calcLeadTime",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.generateDashboard",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.generateDashboard",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.interpretMetrics",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.interpretMetrics",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.regenerateDashboard",
          "when": "view == aiFlowMetrics.pipeline && viewItem == step.regenerateDashboard",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.runFetchAndCheckGroup",
          "when": "view == aiFlowMetrics.pipeline && viewItem == group.fetchAndCheck",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.runCalculationsGroup",
          "when": "view == aiFlowMetrics.pipeline && viewItem == group.calculateMetrics",
          "group": "inline"
        },
        {
          "command": "ai-flow-metrics.deleteFile",
          "when": "view == aiFlowMetrics.boards && viewItem == outputFile",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run copy-scripts && npm run compile",
    "copy-scripts": "node -e \"require('fs').mkdirSync('resources/scripts/prompts',{recursive:true});require('fs').mkdirSync('resources/scripts/templates',{recursive:true});['fetch_data.py','util_ado.py','check_data.py','ai_configure_board.py','calc_columns.py','calc_cycle_time.py','calc_lead_time.py','create_dashboard.py','ai_interpret_metrics.py'].forEach(f=>require('fs').copyFileSync(require('path').join('..','src',f),'resources/scripts/'+f));require('fs').copyFileSync(require('path').join('..','src','prompts','ai_configure_board.prompt.md'),'resources/scripts/prompts/ai_configure_board.prompt.md');require('fs').copyFileSync(require('path').join('..','src','prompts','ai_interpret_metrics.prompt.md'),'resources/scripts/prompts/ai_interpret_metrics.prompt.md');require('fs').copyFileSync(require('path').join('..','src','templates','dashboard.html'),'resources/scripts/templates/dashboard.html');\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
