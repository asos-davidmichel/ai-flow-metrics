{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extension",
                "--user-data-dir=${workspaceFolder}/extension/.dev-profile",
                "${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/extension/out/**/*.js"
            ],
            "preLaunchTask": "compile-extension"
        }
    ]
}
